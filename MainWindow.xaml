<Window x:Class="FinalWork.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinalWork"
        mc:Ignorable="d"
        Title="File Manager" Height="500" Width="900"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="5">
            <TextBlock Text="Ліва панель" FontSize="14" Margin="5,0,0,5" FontWeight="Bold"/>
            <ListView x:Name="LeftFileListView" Height="314">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Назва:" DisplayMemberBinding="{Binding Name}" Width="125"/>
                        <GridViewColumn Header="Розмір:" DisplayMemberBinding="{Binding Size}" Width="75"/>
                        <GridViewColumn Header="Шлях:" DisplayMemberBinding="{Binding FullPath}" Width="150"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="5">
            <TextBlock Text="Права панель" FontSize="14" Margin="5,0,0,5" FontWeight="Bold"/>

            <ListView x:Name="RightFileListView" Height="312" ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="100" Height="100" Margin="5" ToolTip="{Binding FullPath}">
                            <Image Source="https://cdn-icons-png.flaticon.com/512/2965/2965333.png" 
                           Height="64" Width="64" Margin="5"/>

                            <TextBlock Text="{Binding Name}" 
                               HorizontalAlignment="Center" 
                               TextAlignment="Center" 
                               TextWrapping="Wrap"
                               FontSize="11"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>
        </StackPanel>
        <Button Content="Відкрити" Width="143" Height="33" Margin="10,436,297,15" Click="OpenFile1"/>
        <Button Content="Назад" Width="143" Height="33" Margin="297,436,10,15" Click="CloseFile1"/>
        <Button Content="Відкрити" Width="143" Height="33" Margin="10,436,297,15" Grid.Column="1" Click="OpenFile2"/>
        <Button Content="Назад" Width="143" Height="33" Margin="297,436,10,15" Grid.Column="1" Click="CloseFile2"/>
        <TextBox HorizontalAlignment="Left" Margin="10,361,0,0" TextWrapping="Wrap" x:Name="PathBox1" VerticalAlignment="Top" Width="435" Height="27"/>
        <TextBox HorizontalAlignment="Center" Margin="0,361,0,0" TextWrapping="Wrap" x:Name="PathBox2" VerticalAlignment="Top" Width="435" Height="27" Grid.Column="1"/>
    </Grid>
</Window>